{
  "name": "@polito-mcp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono + MCP server that proxies the PoliTO student API.",
  "license": "AGPL-3.0-or-later",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "build:widgets": "mcp-use build --no-typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@mcp-use/inspector": "^6.0.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "mcp-use": "^1.28.0",
    "pino": "^9.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.14",
    "vitest": "^2.1.8"
  }
}
