# --- Required ---

# Upstream PoliTO API base URL. Use the mock for dev, the real one for prod.
#   Mock:  https://app.didattica.polito.it/mock/api
#   Real:  https://app.didattica.polito.it/api
POLITO_BASE_URL=https://app.didattica.polito.it/mock/api

# Public origin of this server. Used for issuer + OAuth discovery.
#   Dev:   http://localhost:8787
#   Prod:  https://your-domain.example
PUBLIC_ORIGIN=http://localhost:8787

# 32-byte hex string. `openssl rand -hex 32` to generate.
# Used as the HKDF master key for per-user token encryption.
ENC_MASTER_KEY=

# 32-byte hex string. `openssl rand -hex 32` to generate.
# Used to sign our short-lived OAuth/JWT access tokens.
JWT_SECRET=

# --- Optional ---

# HTTP port (default 8787).
PORT=8787

# pretty | json (default json in production, pretty in dev).
LOG_LEVEL=info

# Path to the SQLite database file.
DB_PATH=./data/polito-mcp.sqlite

# Sentry DSN (optional). Body redaction is enforced regardless.
SENTRY_DSN=
