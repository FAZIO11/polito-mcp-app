---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<a href="/" class={`group inline-flex items-center gap-2.5 ${className}`} aria-label="polito-mcp home">
  <span class="grid h-7 w-7 place-items-center bg-blue text-white transition-colors group-hover:bg-blue-bright">
    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2 3 6.5v11L12 22l9-4.5v-11L12 2Z" />
      <path d="M3 6.5 12 11l9-4.5M12 22V11" opacity="0.55" />
    </svg>
  </span>
  <span class="font-mono text-[13px] font-medium tracking-tight text-white">
    polito<span class="text-ash-dim">-</span><span class="text-blue-bright">mcp</span>
  </span>
</a>
