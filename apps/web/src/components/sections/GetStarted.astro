---
import CodeBlock from "../CodeBlock.astro";
import { site } from "../../lib/site";

const config = `{
  "mcpServers": {
    "polito": {
      "url": "${site.mcpUrl}"
    }
  }
}`;

const clients = ["Claude Desktop", "Cursor", "Windsurf", "VS Code"];
---

<section class="mx-auto max-w-7xl border-t border-line px-5 sm:px-8">
  <div class="grid gap-12 py-16 lg:grid-cols-[1fr_1fr] lg:gap-16 lg:py-24">
    <div>
      <div class="flex items-center gap-3">
        <span class="font-mono text-xs text-blue">05</span>
        <span class="label">Get started</span>
      </div>
      <h2 class="reveal mt-5 font-display text-5xl text-white sm:text-6xl lg:text-7xl" data-delay="40">
        Connect in
        <span class="text-blue">under a minute.</span>
      </h2>
      <p class="reveal mt-5 max-w-md text-base leading-relaxed text-ash" data-delay="80">
        Add the server to your client's config, restart, and sign in once on the
        PoliTO login page. That's the whole setup.
      </p>

      <ul class="reveal mt-7 flex flex-wrap gap-x-6 gap-y-2" data-delay="120">
        {
          clients.map((c) => (
            <li class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.12em] text-ash">
              <span class="text-blue-bright">+</span>
              {c}
            </li>
          ))
        }
      </ul>

      <div class="reveal mt-9 flex flex-wrap gap-3" data-delay="160">
        <a
          href="/docs/quickstart/"
          class="inline-flex h-11 items-center bg-orange px-6 font-mono text-xs uppercase tracking-[0.16em] text-white"
          style="box-shadow: var(--shadow-cta)"
        >
          Full setup guide →
        </a>
        <a
          href={site.repo}
          target="_blank"
          rel="noopener"
          class="inline-flex h-11 items-center border border-line-strong px-6 font-mono text-xs uppercase tracking-[0.16em] text-white transition-colors hover:bg-near"
        >
          Star on GitHub ↗
        </a>
      </div>
    </div>

    <div class="reveal lg:pt-4" data-delay="120">
      <p class="label mb-3">Add to your client config</p>
      <CodeBlock code={config} title="claude_desktop_config.json" />
      <p class="mt-3 font-mono text-[11px] leading-relaxed text-ash-dim">
        On the first request your client opens the login page automatically — no API
        key, no token to paste.
      </p>
    </div>
  </div>
</section>
