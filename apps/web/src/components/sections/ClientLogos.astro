---
// Display client logos with proper attribution

const clients = [
  { name: "Claude", logo: "/logos/claude.svg", color: "#D97757" },
  { name: "ChatGPT", logo: "/logos/openai.svg", color: "#10a37f" },
  { name: "Cursor", logo: "/logos/cursor.svg", color: "#ffffff" },
  { name: "Windsurf", logo: "/logos/windsurf.svg", color: "#00c4cc" },
  { name: "VS Code", logo: "/logos/vscode.svg", color: "#007acc" },
];
---

<section class="relative border-b border-line py-16 sm:py-20">
  <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
    <div class="text-center">
      <h2 class="reveal is-in font-display text-[clamp(2.5rem,6vw,4rem)] text-white">
        Works<span class="text-blue">—</span>with
      </h2>
      <p class="reveal is-in mt-3 text-ash" data-delay="40">
        Any MCP-compatible AI client. Connects in seconds.
      </p>
    </div>

    <div class="reveal is-in mt-12 grid grid-cols-2 gap-6 sm:mt-16 sm:grid-cols-5 sm:gap-8" data-delay="80">
      {clients.map((client) => (
        <div class="group flex flex-col items-center gap-4 border border-line bg-near p-6 transition-all hover:border-line-strong sm:p-8">
          <div class="grid h-14 w-14 place-items-center transition-all group-hover:scale-110 sm:h-16 sm:w-16">
            <img 
              src={client.logo} 
              alt={`${client.name} logo`}
              class="h-full w-full client-logo"
              style={`filter: brightness(0) saturate(100%) invert(100%); --brand-color: ${client.color};`}
            />
          </div>
          <span class="font-mono text-xs uppercase tracking-[0.16em] text-ash transition-colors group-hover:text-white">
            {client.name}
          </span>
        </div>
      ))}
    </div>

    <p class="reveal is-in mt-10 text-center font-mono text-[10px] uppercase tracking-[0.16em] text-ash-dim" data-delay="120">
      Logos are trademarks of their respective owners · polito-mcp is unofficial
    </p>
  </div>
</section>

<style>
  .client-logo {
    transition: filter 0.3s ease;
  }
  
  /* Show logos in white by default, brand color on hover */
  .group:hover .client-logo[style*="--brand-color"] {
    filter: none !important;
  }
  
  /* Apply brand colors individually */
  .group:hover .client-logo {
    opacity: 1;
  }
  
  /* For Claude (coral/orange) */
  .group:hover img[alt="Claude logo"] {
    filter: brightness(0) saturate(100%) invert(60%) sepia(27%) saturate(1844%) hue-rotate(330deg) brightness(91%) contrast(88%) !important;
  }
  
  /* For ChatGPT/OpenAI (green) */
  .group:hover img[alt="ChatGPT logo"] {
    filter: brightness(0) saturate(100%) invert(53%) sepia(64%) saturate(430%) hue-rotate(106deg) brightness(93%) contrast(88%) !important;
  }
  
  /* For Cursor (white, already visible) */
  .group:hover img[alt="Cursor logo"] {
    filter: brightness(0) saturate(100%) invert(100%) !important;
  }
  
  /* For Windsurf (cyan) */
  .group:hover img[alt="Windsurf logo"] {
    filter: brightness(0) saturate(100%) invert(69%) sepia(76%) saturate(2198%) hue-rotate(143deg) brightness(99%) contrast(101%) !important;
  }
  
  /* For VS Code (blue) */
  .group:hover img[alt="VS Code logo"] {
    filter: brightness(0) saturate(100%) invert(40%) sepia(98%) saturate(1677%) hue-rotate(185deg) brightness(98%) contrast(101%) !important;
  }
</style>
