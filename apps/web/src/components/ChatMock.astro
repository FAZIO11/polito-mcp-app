---
import Icon from "./Icon.astro";
// "Show the real thing" — a morning-brief query resolving to live data via
// three tool calls, rendered as a terminal-flavoured panel.
---

<div class="border border-line bg-near">
  <!-- title bar -->
  <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
    <div class="flex items-center gap-2">
      <span class="h-2.5 w-2.5 bg-line-strong"></span>
      <span class="h-2.5 w-2.5 bg-line-strong"></span>
      <span class="h-2.5 w-2.5 bg-line-strong"></span>
    </div>
    <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-ash">
      <span class="h-1.5 w-1.5 bg-emerald-400"></span>
      polito · connected
    </span>
  </div>

  <div class="space-y-4 p-4 sm:p-5">
    <!-- user -->
    <div class="flex justify-end">
      <div class="max-w-[88%] border border-line-strong bg-black px-4 py-2.5 text-sm text-white">
        What's my morning look like? Lectures, anything due, and unread messages.
      </div>
    </div>

    <!-- assistant -->
    <div class="space-y-3">
      <!-- tool calls -->
      <div class="flex flex-wrap gap-1.5">
        {
          ["list_today_lectures", "list_deadlines", "list_messages"].map((t) => (
            <span class="inline-flex items-center gap-1.5 border border-line bg-black px-2 py-1 font-mono text-[10px] text-ash">
              <Icon name="bolt" class="h-3 w-3 text-blue-bright" />
              {t}
            </span>
          ))
        }
      </div>

      <div class="border-l-2 border-blue bg-black/40 px-4 py-3 text-sm leading-relaxed text-ash">
        <p class="text-white">Here's your morning:</p>
        <ul class="mt-2.5 space-y-2">
          <li class="flex items-start gap-2.5">
            <span class="mt-px font-mono text-xs text-blue-bright">09:00</span>
            <span><span class="text-white">Database Systems</span> — Room 3D, Cittadella</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-px font-mono text-xs text-blue-bright">11:30</span>
            <span><span class="text-white">Machine Learning</span> — Aula Magna</span>
          </li>
        </ul>
        <p class="mt-3">
          <span class="text-orange">!</span> <span class="text-white">Networks</span> lab report due
          <span class="text-white">tomorrow, 23:59</span>. You have
          <span class="text-white">2 unread messages</span> — one from the secretariat
          about exam enrolment.
        </p>
      </div>
    </div>
  </div>
</div>
